{
  "name": "birdleague",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "seed": "node scripts/seed-birds.mjs",
    "test": "jest --selectProjects unit api config",
    "test:unit": "jest --selectProjects unit",
    "test:api": "jest --selectProjects api",
    "test:config": "jest --selectProjects config",
    "test:rules": "npx --yes firebase-tools emulators:exec --only firestore,storage --project birdapp-rules-test \"npx jest --selectProjects rules\"",
    "test:all": "npm run test && npm run test:rules",
    "audit:firebase": "node scripts/extract-firebase-usage.js"
  },
  "dependencies": {
    "@expo-google-fonts/nunito": "^0.4.2",
